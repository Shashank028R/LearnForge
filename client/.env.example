# LearnForge Client Environment Configuration Example
# Copy this file to .env.local or .env for local client development.
#
# SECURITY CLASSIFICATION:
# All variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER place private keys, API secrets, or GOOGLE_CLIENT_SECRET in this file.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth 2.0 Client ID (Browser-safe public identifier from Google Cloud Console)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

