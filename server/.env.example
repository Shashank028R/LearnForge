# LearnForge Server Environment Configuration Example
# Copy this file to .env and configure local values.
# NEVER commit real credentials to version control.

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
# Local development or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/learnforge

# ==============================================================================
# SERVER-ONLY SECRETS (NEVER expose to frontend or commit to version control)
# ==============================================================================

# High-entropy secret for hashing session cookies and tokens (min 32 characters)
SESSION_SECRET=development_session_secret_change_in_production_min_32_chars

# Server-side secret pepper for HMAC-SHA-256 OTP hashing (offline guessing defense)
# Keep strictly separate from MongoDB database storage
OTP_HMAC_SECRET=development_otp_hmac_secret_pepper_keep_separate_from_db

# Google OAuth 2.0 / Google Identity Services (GIS)
# Public-safe client ID used to verify ID tokens received from the web client.
# Matches VITE_GOOGLE_CLIENT_ID in client/.env.
# NOTE: GIS token verification does NOT use or require a GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Transactional Email Service
# Supported providers in current implementation: 'console' (logs OTP to stdout for local development) or 'smtp' (real delivery)
# NOTE: Resend or other third-party SDKs are NOT currently implemented; use 'smtp' for live email delivery.
EMAIL_PROVIDER=console
EMAIL_FROM=LearnForge <no-reply@learnforge.local>

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to 'false' for STARTTLS (typically port 587) or 'true' for TLS/SSL (typically port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# OTP Security Parameters
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Phase 05: AI Gateway & Provider Configuration
# Server-only secrets: NEVER expose to frontend or commit to version control
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=your_groq_api_key_placeholder
GROQ_MODEL=openai/gpt-oss-20b

# AI Routing & Reliability Parameters
AI_PROVIDER_PRIORITY=gemini,openai,groq
AI_DEFAULT_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
