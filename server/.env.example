# LearnForge Server Environment Configuration Example
# Copy this file to .env and configure local values.
# NEVER commit real credentials to version control.

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
# Local development or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/learnforge

# Phase 01: Authentication Configuration
# High-entropy secret for hashing session cookies and tokens
SESSION_SECRET=development_session_secret_change_in_production_min_32_chars
# Server-side secret pepper for HMAC-SHA-256 OTP hashing (offline guessing defense)
OTP_HMAC_SECRET=development_otp_hmac_secret_pepper_keep_separate_from_db

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Transactional Email Service
# 'console' (logs OTP to stdout for local development), 'smtp', or 'resend'
EMAIL_PROVIDER=console
EMAIL_FROM=LearnForge <no-reply@learnforge.local>
# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OTP Security Parameters
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Future Phase Placeholders (Do not set active secrets in Phase 01)
# Phase 05: AI Gateway Provider Keys
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
