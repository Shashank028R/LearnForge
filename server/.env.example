# LearnForge Server Environment Configuration Example
# Copy this file to .env and configure local values.
# NEVER commit real credentials to version control.

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
# Local development or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/learnforge

# Future Phase Placeholders (Do not set active secrets in Phase 00)
# Phase 01: Authentication (JWT/Session secret, Google OAuth credentials)
# SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=

# Phase 05: AI Gateway Provider Keys
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
